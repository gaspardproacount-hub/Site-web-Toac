# ────────────────────────────────────────────────────────────────────────
# Copiez ce fichier en .env.local (dev) ou renseignez ces variables dans
# les "Environment Variables" de votre projet Vercel (prod). Ne committez
# JAMAIS de vraies valeurs dans un fichier .env versionné.
# ────────────────────────────────────────────────────────────────────────

# Clé secrète utilisée pour signer les cookies de session de l'espace
# adhérents. Générez une valeur aléatoire longue, par ex. :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Optionnel : si définie, tout le site demande un mot de passe (fenêtre du
# navigateur) avant d'afficher quoi que ce soit — utile tant que le site
# n'est pas prêt à être montré publiquement. Laissez vide pour un site
# public normal. N'importe quel identifiant convient, seul le mot de passe
# est vérifié.
SITE_PASSWORD=

# Optionnel : même principe que SITE_PASSWORD, mais s'applique uniquement à
# l'URL Vercel générée automatiquement (*.vercel.app), pas au domaine de
# production. Utile pour garder cette URL fermée aux devs/tests une fois le
# vrai domaine (toac-triathlon.com) passé en public.
PREVIEW_SITE_PASSWORD=

# ─── Monetico Paiement (Crédit Mutuel / CIC) ───────────────────────────
# Récupérables dans l'espace commerçant Monetico du club.
MONETICO_TPE=
MONETICO_CODE_SOCIETE=
MONETICO_CLE_HMAC=
# URL de base du site (sans slash final), utilisée pour les redirections
# de fin de paiement, ex. https://toac-triathlon.vercel.app
MONETICO_URL_RETOUR=
# Passez à "true" pour utiliser la plateforme de test Monetico avant la
# mise en production (TPE de test fourni par Monetico).
MONETICO_TEST_MODE=true

# ─── Envoi d'emails (formulaire de contact) ────────────────────────────
# Optionnel : sans clé Brevo, les messages du formulaire de contact sont
# simplement journalisés côté serveur (mode démo).
BREVO_API_KEY=
# Adresse d'expédition : doit être un expéditeur vérifié dans votre compte
# Brevo (Senders, Domains & Dedicated IPs → Senders).
BREVO_FROM_EMAIL=

# ─── Base de données (commandes Monetico + demandes d'adhésion) ───────
# Chaîne de connexion Postgres. N'importe quel Postgres gratuit convient :
# Vercel Postgres/Neon (recommandé, intégration en un clic depuis Vercel),
# Supabase, Railway… Sans cette variable, les commandes Monetico et les
# demandes d'adhésion en ligne ne sont pas enregistrées (voir README § 5bis).
DATABASE_URL=

# ─── Stockage des justificatifs (tarif réduit) ─────────────────────────
# Jeton fourni par Vercel Blob (projet Vercel → Storage → Create Database →
# Blob, offre gratuite). Sans cette variable, les justificatifs uploadés
# dans le formulaire d'adhésion ne sont pas conservés (le reste du
# formulaire continue de fonctionner).
#
# Le store doit être créé en accès PRIVÉ (`--access private`) : le code dépose
# les fichiers avec access: "private" et les sert via /api/documents après
# contrôle d'accès. Sur un store public, ces appels échouent. Voir README § 6bis.
BLOB_READ_WRITE_TOKEN=

# Repli facultatif : même valeur que BLOB_READ_WRITE_TOKEN, sous un nom que
# Vercel ne gère pas lui-même. À renseigner uniquement si BLOB_READ_WRITE_TOKEN
# n'arrive pas jusqu'à la fonction au runtime (voir README § 6bis, « Si l'upload
# échoue » et la page /espace-adherents/bureau/diagnostic).
TOAC_BLOB_TOKEN=

# Dépannage : chaîne aléatoire quelconque qui ouvre /api/diagnostic?key=…
# (état réel des variables vues par le serveur, test d'écriture Blob). Laissez
# vide en temps normal : la route est alors fermée. Voir README § 6bis.
DIAGNOSTIC_KEY=

# Le formulaire de la page Musculation (décharge salle de musculation) utilise
# aussi DATABASE_URL (dossiers) et BLOB_READ_WRITE_TOKEN (décharge PDF générée
# + certificat médical) ci-dessus — aucune variable supplémentaire à renseigner.
